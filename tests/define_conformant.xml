<?xml version="1.0" encoding="UTF-8"?>
<!-- A minimal Submission-context Define-XML v2.1 document that passes every document-checkable
     conformance rule. It is the base the mutation tests in tests/test_conformance.py edit, one
     rule at a time, so every element here is there to satisfy a rule: the annotated CRF and the
     page references for the Collected origins (44, 159), the SUPPDM dataset with its Alias, QVAL
     value list and where clause (55, 95, 96), the derived AGE with its method (73), the codelist
     with NCI aliases (249), the non-standard codelists (153), the keys (70) and the SAS names (147). -->
<ODM xmlns="http://www.cdisc.org/ns/odm/v1.3"
     xmlns:def="http://www.cdisc.org/ns/def/v2.1"
     xmlns:xlink="http://www.w3.org/1999/xlink"
     ODMVersion="1.3.2"
     FileOID="www.example.org/define/conformant"
     FileType="Snapshot"
     CreationDateTime="2026-01-15T10:30:00"
     Originator="defineutils tests"
     SourceSystem="defineutils"
     SourceSystemVersion="0.4.0"
     def:Context="Submission">
  <Study OID="STUDY.CONFORMANT">
    <GlobalVariables>
      <StudyName>Conformant Study</StudyName>
      <StudyDescription>A minimal Define-XML v2.1 document that passes every document-checkable conformance rule</StudyDescription>
      <ProtocolName>CONFORMANT-01</ProtocolName>
    </GlobalVariables>
    <MetaDataVersion OID="MDV.CONFORMANT" Name="Conformant metadata" def:DefineVersion="2.1.0" def:CommentOID="COM.MDV">
      <def:Standards>
        <def:Standard OID="STD.SDTMIG" Name="SDTMIG" Type="IG" Version="3.4" Status="Final"/>
        <def:Standard OID="STD.CT" Name="CDISC/NCI" Type="CT" PublishingSet="SDTM" Version="2025-03-28" Status="Final"/>
      </def:Standards>
      <def:AnnotatedCRF>
        <def:DocumentRef leafID="LF.ACRF"/>
      </def:AnnotatedCRF>
      <def:SupplementalDoc>
        <def:DocumentRef leafID="LF.RG"/>
      </def:SupplementalDoc>
      <def:ValueListDef OID="VL.SUPPDM.QVAL">
        <ItemRef ItemOID="IT.SUPPDM.QVAL.RACEOTH" OrderNumber="1" Mandatory="No">
          <def:WhereClauseRef WhereClauseOID="WC.SUPPDM.QNAM.RACEOTH"/>
        </ItemRef>
      </def:ValueListDef>
      <def:WhereClauseDef OID="WC.SUPPDM.QNAM.RACEOTH">
        <RangeCheck Comparator="EQ" SoftHard="Soft" def:ItemOID="IT.SUPPDM.QNAM">
          <CheckValue>RACEOTH</CheckValue>
        </RangeCheck>
      </def:WhereClauseDef>
      <ItemGroupDef OID="IG.DM" Name="DM" Domain="DM" Repeating="No" IsReferenceData="No" SASDatasetName="DM"
                    Purpose="Tabulation" def:Structure="One record per subject" def:StandardOID="STD.SDTMIG"
                    def:ArchiveLocationID="LF.DM" def:CommentOID="COM.DM">
        <Description>
          <TranslatedText xml:lang="en">Demographics</TranslatedText>
        </Description>
        <ItemRef ItemOID="IT.DM.STUDYID" OrderNumber="1" Mandatory="Yes" KeySequence="1"/>
        <ItemRef ItemOID="IT.DM.USUBJID" OrderNumber="2" Mandatory="Yes" KeySequence="2"/>
        <ItemRef ItemOID="IT.DM.AGE" OrderNumber="3" Mandatory="No" MethodOID="MT.DM.AGE"/>
        <ItemRef ItemOID="IT.DM.SEX" OrderNumber="4" Mandatory="Yes"/>
        <def:Class Name="SPECIAL PURPOSE"/>
        <def:leaf ID="LF.DM" xlink:href="dm.xpt">
          <def:title>dm.xpt</def:title>
        </def:leaf>
      </ItemGroupDef>
      <ItemGroupDef OID="IG.SUPPDM" Name="SUPPDM" Domain="DM" Repeating="Yes" IsReferenceData="No" SASDatasetName="SUPPDM"
                    Purpose="Tabulation" def:Structure="One record per IDVAR, IDVARVAL, and QNAM value per subject"
                    def:StandardOID="STD.SDTMIG" def:ArchiveLocationID="LF.SUPPDM">
        <Description>
          <TranslatedText xml:lang="en">Supplemental Qualifiers for DM</TranslatedText>
        </Description>
        <ItemRef ItemOID="IT.SUPPDM.STUDYID" OrderNumber="1" Mandatory="Yes" KeySequence="1"/>
        <ItemRef ItemOID="IT.SUPPDM.USUBJID" OrderNumber="2" Mandatory="Yes" KeySequence="2"/>
        <ItemRef ItemOID="IT.SUPPDM.QNAM" OrderNumber="3" Mandatory="Yes" KeySequence="3"/>
        <ItemRef ItemOID="IT.SUPPDM.QVAL" OrderNumber="4" Mandatory="Yes"/>
        <Alias Context="DomainDescription" Name="Supplemental Qualifiers for DM"/>
        <def:Class Name="RELATIONSHIP"/>
        <def:leaf ID="LF.SUPPDM" xlink:href="suppdm.xpt">
          <def:title>suppdm.xpt</def:title>
        </def:leaf>
      </ItemGroupDef>
      <ItemDef OID="IT.DM.STUDYID" Name="STUDYID" DataType="text" Length="12" SASFieldName="STUDYID">
        <Description>
          <TranslatedText xml:lang="en">Study Identifier</TranslatedText>
        </Description>
        <def:Origin Type="Protocol"/>
      </ItemDef>
      <ItemDef OID="IT.DM.USUBJID" Name="USUBJID" DataType="text" Length="20" SASFieldName="USUBJID">
        <Description>
          <TranslatedText xml:lang="en">Unique Subject Identifier</TranslatedText>
        </Description>
        <def:Origin Type="Assigned" Source="Sponsor"/>
      </ItemDef>
      <ItemDef OID="IT.DM.AGE" Name="AGE" DataType="integer" Length="3" SASFieldName="AGE">
        <Description>
          <TranslatedText xml:lang="en">Age</TranslatedText>
        </Description>
        <def:Origin Type="Derived"/>
      </ItemDef>
      <ItemDef OID="IT.DM.SEX" Name="SEX" DataType="text" Length="1" SASFieldName="SEX">
        <Description>
          <TranslatedText xml:lang="en">Sex</TranslatedText>
        </Description>
        <CodeListRef CodeListOID="CL.SEX"/>
        <def:Origin Type="Collected" Source="Investigator">
          <def:DocumentRef leafID="LF.ACRF">
            <def:PDFPageRef PageRefs="3" Type="PhysicalRef"/>
          </def:DocumentRef>
        </def:Origin>
      </ItemDef>
      <ItemDef OID="IT.SUPPDM.STUDYID" Name="STUDYID" DataType="text" Length="12" SASFieldName="STUDYID">
        <Description>
          <TranslatedText xml:lang="en">Study Identifier</TranslatedText>
        </Description>
        <def:Origin Type="Protocol"/>
      </ItemDef>
      <ItemDef OID="IT.SUPPDM.USUBJID" Name="USUBJID" DataType="text" Length="20" SASFieldName="USUBJID">
        <Description>
          <TranslatedText xml:lang="en">Unique Subject Identifier</TranslatedText>
        </Description>
        <def:Origin Type="Assigned" Source="Sponsor"/>
      </ItemDef>
      <ItemDef OID="IT.SUPPDM.QNAM" Name="QNAM" DataType="text" Length="8" SASFieldName="QNAM">
        <Description>
          <TranslatedText xml:lang="en">Qualifier Variable Name</TranslatedText>
        </Description>
        <CodeListRef CodeListOID="CL.QNAM"/>
        <def:Origin Type="Assigned" Source="Sponsor"/>
      </ItemDef>
      <ItemDef OID="IT.SUPPDM.QVAL" Name="QVAL" DataType="text" Length="200" SASFieldName="QVAL">
        <Description>
          <TranslatedText xml:lang="en">Data Value</TranslatedText>
        </Description>
        <def:ValueListRef ValueListOID="VL.SUPPDM.QVAL"/>
      </ItemDef>
      <ItemDef OID="IT.SUPPDM.QVAL.RACEOTH" Name="QVAL" DataType="text" Length="100">
        <Description>
          <TranslatedText xml:lang="en">Race, Other</TranslatedText>
        </Description>
        <def:Origin Type="Collected" Source="Subject">
          <def:DocumentRef leafID="LF.ACRF">
            <def:PDFPageRef Type="PhysicalRef" FirstPage="4" LastPage="4"/>
          </def:DocumentRef>
        </def:Origin>
      </ItemDef>
      <CodeList OID="CL.SEX" Name="Sex" DataType="text" SASFormatName="$SEX" def:StandardOID="STD.CT">
        <CodeListItem CodedValue="F" OrderNumber="1">
          <Decode>
            <TranslatedText xml:lang="en">Female</TranslatedText>
          </Decode>
          <Alias Context="nci:ExtCodeID" Name="C16576"/>
        </CodeListItem>
        <CodeListItem CodedValue="M" OrderNumber="2">
          <Decode>
            <TranslatedText xml:lang="en">Male</TranslatedText>
          </Decode>
          <Alias Context="nci:ExtCodeID" Name="C20197"/>
        </CodeListItem>
        <Alias Context="nci:ExtCodeID" Name="C66731"/>
      </CodeList>
      <CodeList OID="CL.QNAM" Name="Qualifier Variable Name" DataType="text" SASFormatName="$QNAM" def:IsNonStandard="Yes">
        <EnumeratedItem CodedValue="RACEOTH" OrderNumber="1"/>
      </CodeList>
      <CodeList OID="CL.MEDDRA" Name="MedDRA" DataType="text" def:IsNonStandard="Yes">
        <ExternalCodeList Dictionary="MedDRA" Version="27.0"/>
      </CodeList>
      <MethodDef OID="MT.DM.AGE" Name="Algorithm to derive AGE" Type="Computation">
        <Description>
          <TranslatedText xml:lang="en">Age in years at informed consent, from the birth date and the informed consent date</TranslatedText>
        </Description>
        <FormalExpression Context="SAS">AGE = floor(yrdif(BRTHDT, RFICDT, "AGE"));</FormalExpression>
      </MethodDef>
      <def:CommentDef OID="COM.MDV">
        <Description>
          <TranslatedText xml:lang="en">Metadata for the conformance tests</TranslatedText>
        </Description>
      </def:CommentDef>
      <def:CommentDef OID="COM.DM">
        <Description>
          <TranslatedText xml:lang="en">One record per subject</TranslatedText>
        </Description>
        <def:DocumentRef leafID="LF.RG">
          <def:PDFPageRef Type="NamedDestination" PageRefs="DM"/>
        </def:DocumentRef>
      </def:CommentDef>
      <def:leaf ID="LF.ACRF" xlink:href="acrf.pdf">
        <def:title>Annotated Case Report Form</def:title>
      </def:leaf>
      <def:leaf ID="LF.RG" xlink:href="reviewers-guide.pdf">
        <def:title>Reviewer's Guide</def:title>
      </def:leaf>
    </MetaDataVersion>
  </Study>
</ODM>
